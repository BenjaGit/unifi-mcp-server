# @plugin(@varlock/1password-plugin@1.1.0)
# @initOp(token=$OP_TOKEN, allowAppAuth=true)
# @defaultRequired=false
# @defaultSensitive=false
# ---

# Optional service account token for non-interactive environments.
# Leave blank for local desktop-app auth via the 1Password CLI.
# @type=opServiceAccountToken
OP_TOKEN=

# @sensitive @type=string
UNIFI_API_TYPE=op("op://Private/Coldberg UniFi DreamMachine Pro Max/UNIFI_API_TYPE")

# @sensitive @type=string
UNIFI_LOCAL_API_KEY=op("op://Private/Coldberg UniFi DreamMachine Pro Max/credential")

# @sensitive @type=string
UNIFI_REMOTE_API_KEY=op("op://Private/Coldberg UniFi Site Manager API/credential")

# @sensitive @type=string
UNIFI_LOCAL_HOST=op("op://Private/Coldberg UniFi DreamMachine Pro Max/UNIFI_LOCAL_HOST")
